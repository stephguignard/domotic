# Copier en .env et renseigner les valeurs. Ce fichier est lu à la fois par
# docker-compose et par le Makefile, donc par `make dev`.

# --- Service ---------------------------------------------------------------

DOMOTIC_PORT=8080

# Chemin de développement : make charge ce fichier et la commande tourne
# depuis le poste. En conteneur, docker-compose impose /data/domotic.db,
# qui n'existe pas ici — le renseigner tel quel ferait échouer `make dev`
# sur « unable to open database file ».
DOMOTIC_DB_PATH=./data/domotic.db

# URL publique du service. Elle sert à construire l'URL de callback OAuth2 et
# doit correspondre au caractère près à celle déclarée sur dev.netatmo.com.
# En développement : http://localhost:8080
DOMOTIC_PUBLIC_URL=http://localhost:8080

# --- Emplacement (scènes) ------------------------------------------------
#
# Fuseau dans lequel s'entendent les heures des horaires de scènes. Sans lui,
# le service compte en UTC : un réveil à 07:30 partirait à 09:30 l'été.
DOMOTIC_TIMEZONE=Europe/Zurich

# Coordonnées de la maison (degrés décimaux, est positif), pour les horaires
# au lever et au coucher du soleil. Laisser vides désactive ces horaires.
DOMOTIC_LATITUDE=
DOMOTIC_LONGITUDE=

# --- Netatmo (météo et sécurité) ------------------------------------------
#
# Créer une application sur https://dev.netatmo.com/apps/ puis y déclarer
# l'URL de redirection : <DOMOTIC_PUBLIC_URL>/auth/netatmo/callback
#
# Laisser vide désactive proprement l'intégration.

NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=

# Scopes demandés. read_station suffit pour la météo ; les deux autres ne sont
# utiles que si vous possédez des caméras.
NETATMO_SCOPES=read_station read_camera access_camera

# La station ne remonte ses mesures que toutes les ~10 minutes : interroger
# plus souvent ne ferait que consommer le quota d'API.
NETATMO_POLL_INTERVAL=10m

# --- Somfy TaHoma (API locale) --------------------------------------------
#
# Activer le mode développeur : dans l'application TaHoma, ouvrir les
# paramètres de la passerelle et taper sept fois sur son PIN, puis générer un
# jeton. Le jeton n'est affiché qu'à sa création : le noter immédiatement.
#
# Laisser vide désactive proprement l'intégration.

# Adresse IP de la box — pas son nom .local : la résolution mDNS depuis un
# conteneur Docker sur Synology est peu fiable. Réservez-lui un bail DHCP fixe.
TAHOMA_HOST=

TAHOMA_PORT=8443

# PIN de la passerelle, visible dans l'application, au format 1234-5678-9012.
# Il sert aussi à valider le certificat TLS de la box.
TAHOMA_PIN=

TAHOMA_TOKEN=

# La box rejette les appels au flux d'événements plus rapprochés qu'une
# seconde ; 2 s laisse une marge confortable.
TAHOMA_EVENT_INTERVAL=2s

# --- Shelly Gen2+ (API locale) --------------------------------------------
#
# Modules Plus, Pro, Gen3 et Gen4. Les Gen1 (Shelly 1, 2.5…) parlent une autre
# API et ne sont pas pris en charge.
#
# Laisser vide désactive proprement l'intégration.

# Adresses IP des modules, séparées par des virgules. Comme pour TaHoma, pas de
# nom .local, et un bail DHCP fixe pour chacun.
SHELLY_HOSTS=

# Mot de passe commun des modules, si l'authentification y est activée
# (utilisateur imposé : admin). Vide sinon.
SHELLY_PASSWORD=

# Les modules répondent en local en quelques millisecondes ; une commande
# déclenche de toute façon un relevé immédiat.
SHELLY_POLL_INTERVAL=5s

# --- Philips Hue (API locale v2) ------------------------------------------
#
# Pont carré (v2) ou Bridge Pro ; le pont rond de première génération ne
# parle pas l'API v2.
#
# Laisser les trois vides désactive proprement l'intégration.

# Adresse IP du pont, avec un bail DHCP fixe.
HUE_HOST=

# Identifiant du pont : application Hue > Paramètres > Ponts, ou
#   curl -sk https://<HUE_HOST>/api/0/config   (champ bridgeid)
# Son certificat TLS est émis à ce nom : il sert à authentifier le pont.
HUE_BRIDGE_ID=

# Clé d'application. Renseigner d'abord les deux lignes ci-dessus, puis lancer
#   make hue-pair
# et appuyer sur le bouton du pont dans la minute. Tant que HUE_HOST et
# HUE_BRIDGE_ID sont renseignés sans clé, le service refuse de démarrer.
HUE_APP_KEY=
